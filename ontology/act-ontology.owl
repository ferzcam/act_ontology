    <!-- https://github.com/ferzcam/act_ontology#Obligation_Article_26_1_ -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Obligation_Article_26_1_">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#Obligation"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_26_1"/>
        <rdfs:comment>Take technical and organisational measures to use the system in accordance with its instructions for use.</rdfs:comment>
        <rdfs:label>Take technical and organisational measures to use the system in accordance with its instructions for use.</rdfs:label>
        <appliesToActorRole rdf:resource="https://github.com/ferzcam/act_ontology#Deployer"/>
        <appliesToSystemCategory rdf:resource="https://github.com/ferzcam/act_ontology#HighRiskAISystem"/>
        <evidenceExcerpt>take appropriate technical and organisational measures to ensure they use such systems in accordance with the instructions for use</evidenceExcerpt>
        <hasCondition>pursuant to paragraphs 3 and 6</hasCondition>
    </owl:NamedIndividual>



    <!-- https://github.com/ferzcam/act_ontology#Obligation_Article_26_2_ -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Obligation_Article_26_2_">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#Obligation"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_26_2"/>
        <rdfs:comment>Assign human oversight to natural persons with the necessary competence, training, authority, and support.</rdfs:comment>
        <rdfs:label>Assign human oversight to natural persons with the necessary competence, training, authority, and support.</rdfs:label>
        <appliesToActorRole rdf:resource="https://github.com/ferzcam/act_ontology#Deployer"/>
        <appliesToSystemCategory rdf:resource="https://github.com/ferzcam/act_ontology#HighRiskAISystem"/>
        <evidenceExcerpt>assign human oversight to natural persons who have the necessary competence, training and authority</evidenceExcerpt>
    </owl:NamedIndividual>



    <!-- https://github.com/ferzcam/act_ontology#Obligation_Article_26_4_ -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Obligation_Article_26_4_">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#Obligation"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_26_4"/>
        <rdfs:comment>Ensure input data is relevant and sufficiently representative for the intended purpose of the system.</rdfs:comment>
        <rdfs:label>Ensure input data is relevant and sufficiently representative for the intended purpose of the system.</rdfs:label>
        <appliesToActorRole rdf:resource="https://github.com/ferzcam/act_ontology#Deployer"/>
        <appliesToSystemCategory rdf:resource="https://github.com/ferzcam/act_ontology#HighRiskAISystem"/>
        <evidenceExcerpt>ensure that input data is relevant and sufficiently representative in view of the intended purpose</evidenceExcerpt>
        <hasCondition>to the extent the deployer exercises control over the input data</hasCondition>
    </owl:NamedIndividual>



    <!-- https://github.com/ferzcam/act_ontology#Obligation_Article_26_5_ -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Obligation_Article_26_5_">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#Obligation"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_26_5"/>
        <rdfs:comment>Monitor the operation of the system based on its instructions for use and inform providers where relevant.</rdfs:comment>
        <rdfs:label>Monitor the operation of the system based on its instructions for use and inform providers where relevant.</rdfs:label>
        <appliesToActorRole rdf:resource="https://github.com/ferzcam/act_ontology#Deployer"/>
        <appliesToSystemCategory rdf:resource="https://github.com/ferzcam/act_ontology#HighRiskAISystem"/>
        <evidenceExcerpt>monitor the operation of the high-risk AI system on the basis of the instructions for use</evidenceExcerpt>
        <hasException>shall not cover sensitive operational data of deployers of AI systems which are law enforcement authorities</hasException>
    </owl:NamedIndividual>



    <!-- https://github.com/ferzcam/act_ontology#Obligation_Article_26_6_ -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Obligation_Article_26_6_">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#Obligation"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_26_6"/>
        <rdfs:comment>Keep automatically generated logs for at least six months, to the extent they are under the deployer&apos;s control.</rdfs:comment>
        <rdfs:label>Keep automatically generated logs for at least six months, to the extent they are under the deployer&apos;s control.</rdfs:label>
        <appliesToActorRole rdf:resource="https://github.com/ferzcam/act_ontology#Deployer"/>
        <appliesToSystemCategory rdf:resource="https://github.com/ferzcam/act_ontology#HighRiskAISystem"/>
        <evidenceExcerpt>keep the logs automatically generated by that high-risk AI system to the extent such logs are under their control</evidenceExcerpt>
        <hasCondition>Logs are under the deployer’s control; retention is for a period appropriate to the system’s intended purpose, of at least six months.</hasCondition>
        <hasException>unless provided otherwise in applicable Union or national law, in particular in Union law on the protection of personal data</hasException>
    </owl:NamedIndividual>



    <!-- https://github.com/ferzcam/act_ontology#Obligation_Article_26_7_ -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Obligation_Article_26_7_">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#Obligation"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_26_7"/>
        <rdfs:comment>Inform workers&apos; representatives and affected workers before putting into service or using a high-risk AI system at the workplace.</rdfs:comment>
        <rdfs:label>Inform workers&apos; representatives and affected workers before putting into service or using a high-risk AI system at the workplace.</rdfs:label>
        <appliesToActorRole rdf:resource="https://github.com/ferzcam/act_ontology#Deployer"/>
        <appliesToSystemCategory rdf:resource="https://github.com/ferzcam/act_ontology#HighRiskAISystem"/>
        <evidenceExcerpt>that they will be subject to the use of the high-risk AI system</evidenceExcerpt>
        <hasCondition>Before putting into service or using a high-risk AI system at the workplace</hasCondition>
    </owl:NamedIndividual>



    <!-- https://github.com/ferzcam/act_ontology#Prohibition_Article5_a -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Prohibition_Article5_a">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#Prohibition"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_5_1_a"/>
        <rdfs:comment>Subliminal, manipulative or deceptive techniques materially distorting behaviour causing significant harm</rdfs:comment>
        <rdfs:label>Subliminal, manipulative or deceptive techniques materially distorting behaviour causing significant harm</rdfs:label>
        <concernsPractice rdf:resource="https://github.com/ferzcam/act_ontology#ManipulativePractice"/>
        <evidenceExcerpt>the placing on the market, the putting into service or the use of an AI system that deploys subliminal techniques beyond a person&apos;s consciousness</evidenceExcerpt>
        <hasCondition>Materially distorts behaviour and causes or is reasonably likely to cause significant harm.</hasCondition>
    </owl:NamedIndividual>



    <!-- https://github.com/ferzcam/act_ontology#Prohibition_Article5_b -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Prohibition_Article5_b">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#Prohibition"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_5_1_b"/>
        <rdfs:comment>Exploiting vulnerabilities of a person or group due to age, disability or social/economic situation</rdfs:comment>
        <rdfs:label>Exploiting vulnerabilities of a person or group due to age, disability or social/economic situation</rdfs:label>
        <concernsPractice rdf:resource="https://github.com/ferzcam/act_ontology#VulnerabilityExploitationPractice"/>
        <evidenceExcerpt>exploits any of the vulnerabilities of a natural person or a specific group of persons due to their age, disability</evidenceExcerpt>
        <hasCondition>Materially distorts behaviour and causes or is reasonably likely to cause significant harm.</hasCondition>
    </owl:NamedIndividual>



    <!-- https://github.com/ferzcam/act_ontology#Prohibition_Article5_ba -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Prohibition_Article5_ba">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#Prohibition"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_5_1_ba"/>
        <rdfs:comment>Generation or manipulation of intimate or sexually explicit material of an identifiable person</rdfs:comment>
        <rdfs:label>Generation or manipulation of intimate or sexually explicit material of an identifiable person</rdfs:label>
        <concernsPractice rdf:resource="https://github.com/ferzcam/act_ontology#NonConsensualIntimateContentPractice"/>
        <evidenceExcerpt>generates or manipulates realistic images, videos, audio or similar material of an identifiable natural person&apos;s intimate parts</evidenceExcerpt>
        <hasCondition>Applies where done without that person&apos;s freely-given, specific, informed, unambiguous and explicit consent for that generation or manipulation. Article 5(1a) limits placement, service and use; Article 5(1b) limits manipulation.</hasCondition>
    </owl:NamedIndividual>



    <!-- https://github.com/ferzcam/act_ontology#Prohibition_Article5_bb -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Prohibition_Article5_bb">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#Prohibition"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_5_1_bb"/>
        <rdfs:comment>Generation or manipulation of material within the meaning of Article 2(c) and (e) of Directive 2011/93/EU</rdfs:comment>
        <rdfs:label>Generation or manipulation of material within the meaning of Article 2(c) and (e) of Directive 2011/93/EU</rdfs:label>
        <concernsPractice rdf:resource="https://github.com/ferzcam/act_ontology#ChildSexualAbuseMaterialPractice"/>
        <evidenceExcerpt>an AI system that generates or manipulates material or performance within the meaning of Article 2, points (c) and (e), of Directive 2011/93/EU</evidenceExcerpt>
        <hasException>Except where a &apos;without right&apos; defence applies under national law. Article 5(1a) further limits placement, service and use.</hasException>
    </owl:NamedIndividual>



    <!-- https://github.com/ferzcam/act_ontology#Prohibition_Article5_c -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Prohibition_Article5_c">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#Prohibition"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_5_1_c"/>
        <rdfs:comment>Social scoring (evaluation/classification of persons or groups over time) leading to detrimental or unfavourable treatment</rdfs:comment>
        <rdfs:label>Social scoring (evaluation/classification of persons or groups over time) leading to detrimental or unfavourable treatment</rdfs:label>
        <concernsPractice rdf:resource="https://github.com/ferzcam/act_ontology#SocialScoringPractice"/>
        <evidenceExcerpt>AI systems for the evaluation or classification of natural persons or groups of persons over a certain period of time based on their social behaviour</evidenceExcerpt>
        <hasCondition>Applies where the social score leads to detrimental or unfavourable treatment in contexts unrelated to where the data was collected, or that is unjustified or disproportionate to the behaviour or its gravity.</hasCondition>
    </owl:NamedIndividual>



    <!-- https://github.com/ferzcam/act_ontology#Prohibition_Article5_d -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Prohibition_Article5_d">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#Prohibition"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_5_1_d"/>
        <rdfs:comment>Predictive risk assessment of a person committing a criminal offence based solely on profiling or personality traits</rdfs:comment>
        <rdfs:label>Predictive risk assessment of a person committing a criminal offence based solely on profiling or personality traits</rdfs:label>
        <concernsPractice rdf:resource="https://github.com/ferzcam/act_ontology#SolelyProfilingCrimeRiskPractice"/>
        <evidenceExcerpt>to assess or predict the risk of a natural person committing a criminal offence, based solely on the profiling of a natural person</evidenceExcerpt>
        <hasException>Shall not apply to AI systems used to support the human assessment of a person&apos;s involvement in criminal activity already based on objective and verifiable facts directly linked to a criminal activity.</hasException>
    </owl:NamedIndividual>



    <!-- https://github.com/ferzcam/act_ontology#Prohibition_Article5_e -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Prohibition_Article5_e">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#Prohibition"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_5_1_e"/>
        <rdfs:comment>Untargeted facial-image scraping</rdfs:comment>
        <rdfs:label>Untargeted facial-image scraping</rdfs:label>
        <concernsPractice rdf:resource="https://github.com/ferzcam/act_ontology#UntargetedFacialScrapingPractice"/>
        <evidenceExcerpt>untargeted scraping of facial images from the internet or CCTV footage</evidenceExcerpt>
    </owl:NamedIndividual>



    <!-- https://github.com/ferzcam/act_ontology#Prohibition_Article5_f -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Prohibition_Article5_f">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#Prohibition"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_5_1_f"/>
        <rdfs:comment>Workplace or education emotion inference</rdfs:comment>
        <rdfs:label>Workplace or education emotion inference</rdfs:label>
        <concernsPractice rdf:resource="https://github.com/ferzcam/act_ontology#WorkplaceEducationEmotionPractice"/>
        <evidenceExcerpt>to infer emotions of a natural person in the areas of workplace and education institutions</evidenceExcerpt>
        <hasException>Medical or safety reasons.</hasException>
    </owl:NamedIndividual>



    <!-- https://github.com/ferzcam/act_ontology#Prohibition_Article5_g -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Prohibition_Article5_g">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#Prohibition"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_5_1_g"/>
        <rdfs:comment>Sensitive biometric categorisation</rdfs:comment>
        <rdfs:label>Sensitive biometric categorisation</rdfs:label>
        <concernsPractice rdf:resource="https://github.com/ferzcam/act_ontology#SensitiveBiometricCategorisationPractice"/>
        <evidenceExcerpt>to deduce or infer their race, political opinions, trade union membership</evidenceExcerpt>
        <hasException>Lawfully acquired biometric dataset labelling/filtering and law-enforcement biometric categorisation are excluded.</hasException>
    </owl:NamedIndividual>



    <!-- https://github.com/ferzcam/act_ontology#Prohibition_Article5_h -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Prohibition_Article5_h">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#Prohibition"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_5_1_h"/>
        <rdfs:comment>Article 5(1)(h) prohibition on use in publicly accessible spaces for law enforcement, subject to strictly necessary objectives and further safeguards.</rdfs:comment>
        <rdfs:label>Real-time remote biometric identification in public spaces for law enforcement</rdfs:label>
        <concernsPractice rdf:resource="https://github.com/ferzcam/act_ontology#RealTimeRemoteBiometricIdentificationPractice"/>
        <evidenceExcerpt>the use of ‘real-time’ remote biometric identification systems in publicly accessible spaces</evidenceExcerpt>
        <hasCondition>Use in publicly accessible spaces for law-enforcement purposes.</hasCondition>
        <hasException>Use may be permitted only insofar as strictly necessary for an Article 5(1)(h)(i)–(iii) objective, with the Article 5(2)–(5) safeguards and authorisation rules, including national law and limited urgency provisions.</hasException>
    </owl:NamedIndividual>



