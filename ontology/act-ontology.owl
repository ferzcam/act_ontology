    <!-- https://github.com/ferzcam/act_ontology#Rule_Article6_1 -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Rule_Article6_1">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#ClassificationRule"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_6_1"/>
        <rdfs:comment>Annex I product route to high-risk classification</rdfs:comment>
        <rdfs:label>Annex I product route to high-risk classification</rdfs:label>
        <appliesToSystemCategory rdf:resource="https://github.com/ferzcam/act_ontology#AnnexIProductAISystem"/>
        <evidenceExcerpt>that AI system shall be considered to be high-risk where both of the following conditions are fulfilled</evidenceExcerpt>
        <hasCondition>Both safety-component/product coverage by Annex I legislation and required third-party conformity assessment.</hasCondition>
        <hasException>Article 6(1a) excludes solely non-safety uses, Article 6(1b) restores safety-component status where failure would endanger health or safety, and Article 6(1c) excludes third-party assessment solely for non-health-and-safety risks.</hasException>
    </owl:NamedIndividual>



    <!-- https://github.com/ferzcam/act_ontology#Rule_Article6_2 -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Rule_Article6_2">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#ClassificationRule"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_6_2"/>
        <rdfs:comment>Annex III listed route to high-risk classification</rdfs:comment>
        <rdfs:label>Annex III listed route to high-risk classification</rdfs:label>
        <appliesToSystemCategory rdf:resource="https://github.com/ferzcam/act_ontology#AnnexIIIListedAISystem"/>
        <evidenceExcerpt>AI systems referred to in Annex III shall be considered to be high-risk</evidenceExcerpt>
        <hasCondition>The system is in an Annex III listed use case.</hasCondition>
        <hasException>Article 6(3) derogation may apply to non-profiling systems; a provider invoking it must document the assessment and comply with Article 49(2) registration under Article 6(4).</hasException>
    </owl:NamedIndividual>



    <!-- https://github.com/ferzcam/act_ontology#Rule_Article6_3 -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Rule_Article6_3">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#ClassificationRule"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_6_3"/>
        <rdfs:comment>Annex III derogation from high-risk classification</rdfs:comment>
        <rdfs:label>Annex III derogation from high-risk classification</rdfs:label>
        <appliesToSystemCategory rdf:resource="https://github.com/ferzcam/act_ontology#AnnexIIIListedAISystem"/>
        <evidenceExcerpt>an AI system referred to in Annex III shall not be considered to be high-risk where it does not pose a significant risk</evidenceExcerpt>
        <hasCondition>No significant risk of harm and at least one listed Article 6(3)(a)–(d) circumstance.</hasCondition>
        <hasException>An Annex III system that performs profiling of natural persons is always high-risk.</hasException>
    </owl:NamedIndividual>
</rdf:RDF>



