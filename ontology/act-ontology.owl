    <!-- http://data.europa.eu/eli/reg/2024/1689/2026-07-27 -->

    <owl:NamedIndividual rdf:about="http://data.europa.eu/eli/reg/2024/1689/2026-07-27">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#ActVersion"/>
        <terms:identifier>02024R1689-20260727</terms:identifier>
        <rdfs:comment>Dated consolidated text of Regulation (EU) 2024/1689; documentation aid rather than authentic Official Journal publication.</rdfs:comment>
        <rdfs:label>EU AI Act consolidated 27 July 2026</rdfs:label>
    </owl:NamedIndividual>



    <!-- https://github.com/ferzcam/act_ontology#Obligation_Article16_a -->

    <owl:NamedIndividual rdf:about="https://github.com/ferzcam/act_ontology#Obligation_Article16_a">
        <rdf:type rdf:resource="https://github.com/ferzcam/act_ontology#Obligation"/>
        <prov:wasDerivedFrom rdf:resource="https://github.com/ferzcam/act_ontology#Provision_Article_16_a"/>
        <rdfs:comment>Ensure high-risk AI systems are compliant with the requirements set out in Section 2</rdfs:comment>
        <rdfs:label>Ensure high-risk AI systems are compliant with the requirements set out in Section 2</rdfs:label>
        <appliesToActorRole rdf:resource="https://github.com/ferzcam/act_ontology#Provider"/>
        <appliesToSystemCategory rdf:resource="https://github.com/ferzcam/act_ontology#HighRiskAISystem"/>
        <evidenceExcerpt>ensure that their high-risk AI systems are compliant with the requirements set out in Section 2</evidenceExcerpt>
