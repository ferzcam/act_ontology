    <!-- https://github.com/ferzcam/act_ontology#AIPractice -->

    <owl:Class rdf:about="https://github.com/ferzcam/act_ontology#AIPractice">
        <owl:disjointWith rdf:resource="https://github.com/ferzcam/act_ontology#AISystem"/>
        <rdfs:comment>Use, placement or putting into service of an AI system as described in Article 5.</rdfs:comment>
        <rdfs:label>AI practice</rdfs:label>
        <sourceReference>Article 5</sourceReference>
    </owl:Class>



    <!-- https://github.com/ferzcam/act_ontology#AISystem -->

    <owl:Class rdf:about="https://github.com/ferzcam/act_ontology#AISystem">
        <owl:disjointWith rdf:resource="https://github.com/ferzcam/act_ontology#ActorRole"/>
        <rdfs:comment>Machine-based system as defined by Article 3(1).</rdfs:comment>
        <rdfs:label>AI system</rdfs:label>
        <sourceReference>Article 3(1)</sourceReference>
    </owl:Class>



    <!-- https://github.com/ferzcam/act_ontology#ActVersion -->

    <owl:Class rdf:about="https://github.com/ferzcam/act_ontology#ActVersion">
        <rdfs:comment>Dated version of the Act used as source.</rdfs:comment>
        <rdfs:label>Act version</rdfs:label>
    </owl:Class>



    <!-- https://github.com/ferzcam/act_ontology#ActorRole -->

    <owl:Class rdf:about="https://github.com/ferzcam/act_ontology#ActorRole">
        <rdfs:comment>Role named by the Act.</rdfs:comment>
        <rdfs:label>Actor role</rdfs:label>
    </owl:Class>



    <!-- https://github.com/ferzcam/act_ontology#AnnexIIIListedAISystem -->

    <owl:Class rdf:about="https://github.com/ferzcam/act_ontology#AnnexIIIListedAISystem">
        <rdfs:subClassOf rdf:resource="https://github.com/ferzcam/act_ontology#AISystem"/>
        <rdfs:comment>AI system in an Annex III listed use case; Article 6(3) may exclude high-risk status.</rdfs:comment>
        <rdfs:label>Annex III listed AI system</rdfs:label>
        <sourceReference>Article 6(2)</sourceReference>
    </owl:Class>



    <!-- https://github.com/ferzcam/act_ontology#AnnexIProductAISystem -->

    <owl:Class rdf:about="https://github.com/ferzcam/act_ontology#AnnexIProductAISystem">
        <rdfs:subClassOf rdf:resource="https://github.com/ferzcam/act_ontology#AISystem"/>
        <rdfs:comment>AI system in the Annex I product-related route; further Article 6(1) conditions determine high-risk status.</rdfs:comment>
        <rdfs:label>Annex I product-related AI system</rdfs:label>
        <sourceReference>Article 6(1)</sourceReference>
    </owl:Class>



    <!-- https://github.com/ferzcam/act_ontology#Article5ListedPractice -->

    <owl:Class rdf:about="https://github.com/ferzcam/act_ontology#Article5ListedPractice">
        <rdfs:subClassOf rdf:resource="https://github.com/ferzcam/act_ontology#AIPractice"/>
        <rdfs:comment>A practice described in Article 5(1); whether the prohibition applies depends on the cited statement, conditions and exceptions.</rdfs:comment>
        <rdfs:label>Article 5-listed practice</rdfs:label>
        <sourceReference>Article 5(1)</sourceReference>
    </owl:Class>



    <!-- https://github.com/ferzcam/act_ontology#BiometricsListedAISystem -->

    <owl:Class rdf:about="https://github.com/ferzcam/act_ontology#BiometricsListedAISystem">
        <rdfs:subClassOf rdf:resource="https://github.com/ferzcam/act_ontology#AnnexIIIListedAISystem"/>
        <rdfs:comment>AI systems in the specified Annex III use cases for biometrics; this does not classify every system in the sector as high-risk.</rdfs:comment>
        <rdfs:label>Annex III: Biometrics</rdfs:label>
        <sourceReference>Annex III(1)</sourceReference>
    </owl:Class>



    <!-- https://github.com/ferzcam/act_ontology#ChildSexualAbuseMaterialPractice -->

