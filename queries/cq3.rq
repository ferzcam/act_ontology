PREFIX act: <https://github.com/ferzcam/act_ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?actorLabel ?dutyLabel ?sourceRef WHERE {
  VALUES ?actor { act:Provider act:Deployer }
  ?actor rdfs:label ?actorLabel .
  ?duty rdf:type act:Obligation ; act:appliesToActorRole ?actor ; act:appliesToSystemCategory act:HighRiskAISystem ; rdfs:label ?dutyLabel ; prov:wasDerivedFrom ?provision .
  ?provision dct:identifier ?sourceRef .
} ORDER BY ?actorLabel ?sourceRef
